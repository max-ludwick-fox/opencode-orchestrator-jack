{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "reserved": 160000
  },
  "plugin": [
    "@nick-vi/opencode-type-inject",
    "@tarquinen/opencode-dcp@latest",
    "@franlol/opencode-md-table-formatter@latest",
    "@mohak34/opencode-notifier@latest",
    "./plugin/jack-extras/index.ts"
  ],
  "instructions": [
    "./plugin/shell-strategy/shell_strategy.md"
  ],
  "formatter": {
    "biome": {
      "disabled": true
    },
    "oxfmt": {
      "command": [
        "bun",
        "x",
        "oxfmt",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx"
      ]
    }
  },
  "lsp": {
    "biome": {
      "disabled": true
    },
    "oxlint": {
      "command": [
        "bun",
        "x",
        "oxlint",
        "--lsp"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".vue",
        ".astro",
        ".svelte"
      ]
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "setCacheKey": true,
        "timeout": 600000
      }
    },
    "openai": {
      "options": {
        "setCacheKey": true,
        "timeout": 600000
      }
    },
    "anthropic": {
      "options": {
        "setCacheKey": true,
        "timeout": 600000
      }
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Primary agent that plans, ideates, delegates, and synthesizes — Claude Opus 4.7 1m",
      "mode": "primary",
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "max",
      "prompt": "{file:./prompts/orchestrator.txt}",
      "permission": {
        "task": {
          "planner": "allow",
          "executor-genius": "allow",
          "executor-high": "allow",
          "executor-medium": "allow",
          "executor-low": "allow",
          "suborchestrator": "allow",
          "explore": "allow",
          "explore-high": "allow",
          "reviewer": "allow",
          "designer": "allow",
          "debugger-xhigh": "allow",
          "validator": "allow",
          "deployer": "allow",
          "scribe": "allow",
          "brainstormer": "allow"
        }
      }
    },
    "compaction": {
      "prompt": "{file:./prompts/compaction.txt}"
    },
    "planner": {
      "description": "Drafts implementation plans with complexity assessments. Can explore the codebase — GPT-5.4 with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/planner.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow",
          "explore-high": "allow"
        }
      }
    },
    "debugger-xhigh": {
      "description": "High-complexity code debugging — GPT-5.4 with xhigh reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "prompt": "{file:./prompts/debugger.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "executor-genius": {
      "description": "Highest-complexity code execution — Claude Opus 4.7 1m with high reasoning",
      "mode": "subagent",
      "model": "amazon-bedrock/global.anthropic.claude-opus-4-7",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/executor.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "executor-high": {
      "description": "High-complexity code execution — GPT-5.4 with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/executor.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "executor-medium": {
      "description": "Medium-complexity code execution — Claude Sonnet 4.6 1m",
      "mode": "subagent",
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/executor.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "executor-low": {
      "description": "Low-complexity code execution — GPT-5.4 mini with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/executor.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "suborchestrator": {
      "description": "Manages focused multi-file campaigns — lint fixes, mechanical refactors, migrations — Claude Sonnet 4.6 1m with max reasoning",
      "mode": "subagent",
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6",
      "reasoningEffort": "max",
      "prompt": "{file:./prompts/suborchestrator.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "task": {
          "executor-medium": "allow",
          "executor-low": "allow",
          "explore": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Reviews executor output, runs tests, validates against plan — GPT-5.4 with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/reviewer.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "explore": {
      "description": "Fast, read-only agent for exploring codebases — GPT-5.4 mini",
      "mode": "subagent",
      "model": "openai/gpt-5.4-mini",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/explore.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "explore-high": {
      "description": "Deep codebase exploration for complex analysis — GPT-5.4 with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/explore.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "designer": {
      "description": "UI/UX design specialist — generates design systems and implements UI code using ui-ux-pro-max skill — Claude Sonnet 4.6 1m",
      "mode": "subagent",
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/designer.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "validator": {
      "description": "Runs full project check suite, triages failures, fixes mechanical issues — GPT-5.4 with medium reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/validator.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "deployer": {
      "description": "Gate-based deployment workflows with safety verification — GPT-5.4 with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/deployer.txt}",
      "tools": {
        "write": true,
        "edit": false,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "scribe": {
      "description": "Documentation agent — codifies patterns, conventions, and rules from completed work — GPT-5.4 with medium reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium",
      "prompt": "{file:./prompts/scribe.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "brainstormer": {
      "description": "Explores problem spaces, generates approaches with tradeoffs, recommends direction — GPT-5.4 Pro with high reasoning",
      "mode": "subagent",
      "model": "openai/gpt-5.4-pro",
      "prompt": "{file:./prompts/brainstormer.txt}",
      "reasoningEffort": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    }
  },
  "mcp": {
    "think": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "doc-loader": {
      "type": "local",
      "command": [
        "uvx",
        "awslabs.document-loader-mcp-server"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "cloudwatch": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.cloudwatch-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}"
      }
    },
    "aws-knowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "aws-iac": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.aws-iac-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}"
      }
    },
    "bedrock-kb-retrieval": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.bedrock-kb-retrieval-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}"
      }
    },
    "ccapi": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.ccapi-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}"
      }
    },
    "chrome_devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp"
      ],
      "enabled": true
    },
    "git-research": {
      "type": "local",
      "command": [
        "uvx",
        "awslabs.git-repo-research-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}&tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa,company_research_exa,people_search_exa,deep_researcher_start,deep_researcher_check"
    },
    "ecs": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.ecs-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}"
      }
    },
    "cloudtrail": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.cloudtrail-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}"
      }
    },
    "bedrock-agentcore": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "botocore[crt]",
        "awslabs.amazon-bedrock-agentcore-mcp-server"
      ],
      "environment": {
        "AWS_REGION": "{env:AWS_REGION}",
        "AWS_PROFILE": "{env:AWS_PROFILE}",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}